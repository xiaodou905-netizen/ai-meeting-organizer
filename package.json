{
  "name": "minute-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <23 || >=24.0.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "verify": "node --env-file-if-exists=.env scripts/verify.js"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "~8.3.8"
  }
}
